---
// HookResult — three panels: ranked input hooks, blind spots, generated hooks.
// Client script in /pages/index.astro populates the slots after a successful
// /api/classify response.
---
<section class="result" hidden>
  <header class="result__head">
    <div class="meta">
      <span class="meta__label">Hook sheet</span>
      <span class="meta__client" data-field="client"></span>
    </div>
    <div class="result__actions">
      <button class="btn btn--ghost btn--small" data-copy="new">
        Copy 20 new hooks
      </button>
      <button class="btn btn--ghost btn--small" data-copy="all">
        Copy full sheet
      </button>
    </div>
  </header>

  <article class="block">
    <h3 class="block__h">Your top hooks, ranked + classified</h3>
    <ol class="ranked" data-field="ranked"></ol>
  </article>

  <div class="result__split">
    <article class="block">
      <h3 class="block__h">Pattern distribution</h3>
      <ul class="bars" data-field="distribution"></ul>
    </article>
    <article class="block">
      <h3 class="block__h">Blind spots</h3>
      <p class="hint">
        Patterns the client is NOT using that fit this niche. These are the highest-leverage gaps.
      </p>
      <ul class="blind-spots" data-field="blind_spots"></ul>
    </article>
  </div>

  <article class="block">
    <h3 class="block__h">20 new hooks to film</h3>
    <p class="hint">
      Distributed across blind spots and reinforcing what's already working.
      Each is a filmable line — ≤14 words, niche-specific.
    </p>
    <ol class="new-hooks" data-field="new_hooks"></ol>
  </article>
</section>

<style>
  .result {
    background: var(--surface-0);
    border: 1px solid var(--surface-200);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin-top: 1.5rem;
    box-shadow: var(--shadow-card);
  }
  @media (max-width: 600px) { .result { padding: 1.5rem; } }

  .result__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--surface-200);
  }
  .meta__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--surface-500);
    margin-right: 0.6rem;
  }
  .meta__client {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--surface-900);
  }
  .result__actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .block { margin-bottom: 2rem; }
  .block:last-child { margin-bottom: 0; }
  .block__h {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: 0.5rem;
  }
  .hint {
    color: var(--surface-500);
    font-size: var(--text-sm);
    margin-bottom: 0.85rem;
    max-width: 60ch;
  }

  .result__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  @media (max-width: 760px) {
    .result__split { grid-template-columns: 1fr; }
  }

  .ranked, .new-hooks {
    list-style: none;
    counter-reset: hook;
    padding: 0;
    margin: 0;
  }
  .ranked :global(li), .new-hooks :global(li) {
    background: var(--surface-50);
    border: 1px solid var(--surface-200);
    border-radius: var(--radius);
    padding: 0.85rem 1rem 0.85rem 2.4rem;
    margin-bottom: 0.6rem;
    position: relative;
    counter-increment: hook;
  }
  .ranked :global(li)::before, .new-hooks :global(li)::before {
    content: counter(hook);
    position: absolute;
    left: 0.85rem;
    top: 0.85rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--surface-500);
    font-weight: var(--font-weight-semibold);
  }
  .ranked :global(.hook-text), .new-hooks :global(.hook-text) {
    color: var(--surface-900);
    font-weight: var(--font-weight-semibold);
    margin-bottom: 0.35rem;
  }
  .ranked :global(.hook-meta), .new-hooks :global(.hook-meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.35rem;
  }
  .ranked :global(.pattern-chip), .new-hooks :global(.pattern-chip) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm, 4px);
    background: var(--surface-100);
    color: var(--surface-700);
    border: 1px solid var(--surface-200);
  }
  .ranked :global(.pattern-chip--primary), .new-hooks :global(.pattern-chip--primary) {
    background: oklch(from var(--accent-100) l c h / 0.7);
    color: var(--accent-800);
    border-color: oklch(from var(--accent-500) l c h / 0.4);
    font-weight: var(--font-weight-semibold);
  }
  .ranked :global(.hook-why), .new-hooks :global(.hook-why) {
    font-size: var(--text-sm);
    color: var(--surface-700);
    line-height: var(--leading-relaxed);
  }

  .bars {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .bars :global(li) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.4rem 0.5rem;
    padding: 0.5rem 0;
  }
  .bars :global(.bar-label) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--surface-700);
  }
  .bars :global(.bar-track) {
    grid-column: 1 / -1;
    height: 9px;
    background: var(--surface-100);
    border-radius: var(--radius-sm, 4px);
    overflow: hidden;
  }
  .bars :global(.bar-fill) {
    height: 100%;
    background: var(--accent-500);
    border-radius: var(--radius-sm, 4px);
    transition: width var(--duration-base) var(--ease-smooth);
  }
  .bars :global(.bar-count) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--surface-900);
    font-weight: var(--font-weight-semibold);
  }

  .blind-spots {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  /* Blind spots = gaps to fill. Dashed outline + "+" marker reads as
     "missing / add this" — deliberately distinct from the solid-filled
     primary-pattern chips, even though both stay in the terracotta family. */
  .blind-spots :global(li) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius);
    background: transparent;
    color: var(--accent-700);
    border: 1px dashed oklch(from var(--accent-500) l c h / 0.6);
  }
  .blind-spots :global(li)::before {
    content: "+";
    margin-right: 0.4rem;
    color: oklch(from var(--accent-500) l c h / 0.85);
    font-weight: var(--font-weight-semibold);
  }
</style>
